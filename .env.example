# Copie para .env.local (ou configure na Vercel) SOMENTE com dados confirmados pela clínica.
# Campos vazios = integração desativada.

# Site principal com as páginas /face, /corporal e /privacidade (padrão: https://dr-luis-fernando-salet.vercel.app)
VITE_MAIN_SITE_URL=

# WhatsApp da recepção, apenas dígitos com DDI+DDD (ex.: 5551XXXXXXXXX). Vazio = "Agendar" liga para o telefone fixo.
VITE_WHATSAPP_NUMBER=

# Google Analytics 4 (G-XXXXXXX) e Meta Pixel (ID numérico) — os mesmos do site principal
VITE_GA4_ID=
VITE_META_PIXEL_ID=

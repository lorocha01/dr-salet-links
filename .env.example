# Copie para .env.local e preencha SOMENTE com dados confirmados pela clínica.
# Nada aqui deve ser inventado. Campos vazios = integração desativada.

# WhatsApp da recepção, apenas dígitos com DDI+DDD (ex.: 5551XXXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Google Analytics 4 (G-XXXXXXX)
VITE_GA4_ID=
# Google Ads (AW-XXXXXXXXX) e rótulos de conversão por evento
VITE_GADS_ID=
VITE_GADS_LABEL_WHATSAPP_FACE=
VITE_GADS_LABEL_FORM_FACE=
VITE_GADS_LABEL_WHATSAPP_CORPORAL=
VITE_GADS_LABEL_FORM_CORPORAL=
# Meta Pixel (apenas o ID numérico). O token da API de Conversões NUNCA vai no front-end.
VITE_META_PIXEL_ID=
